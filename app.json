{
  "expo": {
    "name": "mobile-frontend",
    "slug": "mobile-frontend",
    "updates": {
      "url": "https://u.expo.dev/8022200c-9a6c-4869-90bc-f14422e03f85"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobilefrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muchirusorganization.mobilefrontend"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A5C36",
        "foregroundImage": "./assets/images/appicon.jpeg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.muchirusorganization.mobilefrontend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8022200c-9a6c-4869-90bc-f14422e03f85"
      }
    },
    "owner": "muchirus-organization"
  }
}
